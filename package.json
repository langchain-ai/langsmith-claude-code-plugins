{
  "name": "@langchain/langsmith-claude-code-plugins",
  "version": "0.3.1",
  "description": "Claude Code plugin for LangSmith tracing",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc && pnpm bundle",
    "build:binary": "langsmith-plugin-binary build",
    "sign:binary": "langsmith-plugin-binary sign",
    "installer": "langsmith-plugin-binary installer",
    "bundle": "node esbuild.config.mjs",
    "dev": "tsc --watch",
    "format": "oxfmt --write",
    "test": "vitest run",
    "test:binary": "vitest run src/hooks/dispatch.binary.test.ts src/installer.binary.test.ts",
    "test:install": "bash node_modules/@langchain/langsmith-plugin-binary/test/install/cases.sh",
    "test:install:mutations": "bash node_modules/@langchain/langsmith-plugin-binary/test/install/variants.sh",
    "test:watch": "vitest",
    "tsx": "tsx",
    "lint": "pnpm lint:code && pnpm lint:installer",
    "lint:code": "oxlint",
    "lint:installer": "langsmith-plugin-binary installer --check",
    "lint:fix": "oxlint --fix",
    "clean": "rm -rf dist bin"
  },
  "dependencies": {
    "langsmith": "^0.10.4"
  },
  "devDependencies": {
    "@langchain/langsmith-plugin-binary": "github:langchain-ai/langsmith-plugin-binary#v0.1.0",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
