{
  "name": "@langchain/langsmith-claude-code-plugins",
  "version": "0.3.0",
  "description": "Claude Code plugin for LangSmith tracing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && pnpm bundle",
    "bundle": "node esbuild.config.mjs",
    "dev": "tsc --watch",
    "format": "oxfmt --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsx": "tsx",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "langsmith": "^0.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
