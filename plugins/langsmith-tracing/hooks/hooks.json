{
  "description": "LangSmith tracing hooks — traces Claude Code sessions, tool calls, and subagents to LangSmith",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" UserPromptSubmit\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" PreToolUse\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" PostToolUse\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" PostToolUse",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat)\ncase \"$input\" in *'\"transcript_path\":\"'[!\\\"]*) exit 0 ;; esac\nprintf '%s' \"$input\" | \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" PostToolUseFailure || printf '%s' \"$input\" | node \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" PostToolUseFailure",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat)\ncase \"$input\" in *'\"transcript_path\":\"'[!\\\"]*) exit 0 ;; esac\nprintf '%s' \"$input\" | \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" PostToolBatch || printf '%s' \"$input\" | node \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" PostToolBatch",
            "timeout": 10
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat)\ncase \"$input\" in *'\"transcript_path\":\"'[!\\\"]*) exit 0 ;; esac\nprintf '%s' \"$input\" | \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" MessageDisplay || printf '%s' \"$input\" | node \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" MessageDisplay",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" Stop\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" Stop",
            "timeout": 120
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" StopFailure\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" StopFailure",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" SubagentStop\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" SubagentStop",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" PreCompact\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" PreCompact",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" PostCompact\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" PostCompact",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-tracing\" SessionEnd\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
