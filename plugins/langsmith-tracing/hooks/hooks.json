{
  "description": "LangSmith tracing hooks — traces Claude Code sessions, tool calls, and subagents to LangSmith",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" UserPromptSubmit\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" PreToolUse\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" PostToolUse\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing PostToolUse",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" Stop\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing Stop",
            "timeout": 120
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" StopFailure\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing StopFailure",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" SubagentStop\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing SubagentStop",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" PreCompact\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing PreCompact",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" PostCompact\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing PostCompact",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\" SessionEnd\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/dispatch.js\" --plugin tracing SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
