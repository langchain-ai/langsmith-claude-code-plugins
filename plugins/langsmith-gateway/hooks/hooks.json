{
  "description": "Experimental opt-in LangSmith gateway lifecycle hooks (separate from tracing)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\"\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/gateway.js\" --plugin gateway",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\"\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/gateway.js\" --plugin gateway",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/hooks/langsmith-claude-launcher\"\nnode \"${CLAUDE_PLUGIN_ROOT}/bundle/gateway.js\" --plugin gateway",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
