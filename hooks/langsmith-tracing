#!/bin/sh
set -eu

RAN_CODES="0"

root="${CLAUDE_PLUGIN_ROOT:-}"
if [ -z "$root" ]; then
  root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
fi

executable="langsmith-claude-code-tracing"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)
    preferred="$root/binary/$executable-darwin-arm64"
    alternate="$root/binary/$executable-darwin-x64"
    ;;
  Darwin-x86_64)
    preferred="$root/binary/$executable-darwin-x64"
    alternate=""
    ;;
  *)
    preferred=""
    alternate=""
    ;;
esac

ran() {
  case " $RAN_CODES " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

first=""
for candidate in "$preferred" "$alternate"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    first="$candidate"
    break
  fi
done

if [ -z "$first" ]; then
  exec node "$root/bundle/dispatch.js" "$@"
fi

child=""
clean() {
  if [ -n "$child" ]; then kill "$child" 2>/dev/null || :; fi
  rm -f "$event" || :
}

if event="$(mktemp "${TMPDIR:-/tmp}/langsmith-event.XXXXXX" 2>/dev/null)"; then
  trap clean EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 131' QUIT
  trap 'exit 143' TERM
  exec 4<&0
  cat <&4 > "$event" &
  child=$!
  wait "$child"
  child=""
  exec 4<&-
else
  exec node "$root/bundle/dispatch.js" "$@"
fi

unstarted=""
for candidate in "$preferred" "$alternate"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    "$candidate" "$@" < "$event" &
    child=$!
    code=0
    wait "$child" || code=$?
    child=""
    if ran "$code"; then
      exit "$code"
    fi
    unstarted="$candidate exited $code"
  fi
done

( printf '%s\n' "langsmith tracing: carried build did not run ($unstarted); handing the event to node" >&2 ) || :

exec 3< "$event"
rm -f "$event" || :
exec node "$root/bundle/dispatch.js" "$@" <&3
