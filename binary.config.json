{
  "executableName": "langsmith-claude-code-tracing",
  "repository": "langchain-ai/langsmith-claude-code-plugins",
  "build": {
    "entryPoint": "src/hooks/dispatch.ts",
    "outputDirectory": "bin",
    "versionFile": "package.json",
    "matchingVersionFiles": ["plugins/langsmith-tracing/.claude-plugin/plugin.json"],
    "minify": false,
    "defines": {
      "__LS_BINARY_HOOKS__": "plugins/langsmith-tracing/hooks/hooks.binary.json"
    },
    "stampedVersionFiles": ["plugins/langsmith-tracing/bundle/dispatch.js"]
  },
  "sign": {
    "entitlements": "macos-entitlements.plist"
  }
}
